# Template for .env.uat — copy it to .env.uat and fill in the real values from the team lead.
# .env.uat is gitignored: never commit it, and never post real Census IDs in chat, email or tickets.

# Login page of the environment under test (required)
BASE_URL=<UAT login URL>
# 12-digit test Census ID that can log in (required)
CENSUS_ID_VALID=<12-digit test Census ID>
# Census ID that must be rejected (required)
CENSUS_ID_INVALID=000000000000

# Optional: true hides the browser window (default false)
# HEADLESS=true
# Optional: chromium (default), firefox or webkit
# BROWSER=chromium
